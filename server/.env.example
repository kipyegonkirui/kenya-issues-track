# Copy this file to server/.env and fill in a real key.
# Get a key at https://platform.openai.com/api-keys
#
# IMPORTANT: this project previously had a key checked in under the
# misspelled filename server/.eve (missing the "n"), which meant it
# wasn't covered by .gitignore's ".env" rule. If that key was ever
# pushed anywhere, rotate/revoke it on the OpenAI dashboard before
# using this project further, then paste the NEW key below.
OPENAI_API_KEY=

# Port the AI service listens on locally.
PORT=5000

# Required for the automatic accountability-escalation job (server/jobs/escalation.js).
# Firebase Console → Project Settings → Service Accounts → Generate new private key.
# Save the downloaded JSON OUTSIDE the repo and point this at its absolute path.
# Without this set, the escalation job is disabled (logged as a warning on startup)
# and issues will never auto-escalate — status updates from the dashboards still work.
GOOGLE_APPLICATION_CREDENTIALS=
